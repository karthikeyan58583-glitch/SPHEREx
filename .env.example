# ==============================================================================
# SPHEREx TimeLens — Environment Configuration Template
# Copy this file to .env for local configuration overrides.
# DO NOT store real API keys, credentials, or personal secrets in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# FastAPI Backend Server
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Allowed CORS origins (comma-separated URLs for the frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Local Storage & Metadata Cache (Application Defaults)
# ------------------------------------------------------------------------------
# SQLite metadata cache connection string (local file)
DATABASE_URL=sqlite:///./data/cache/timelens_metadata.db

# Cache directory for temporary FITS cutouts and reprojected files
CACHE_DIR=./data/cache

# Planned maximum local cache size in bytes (default: 5 GiB = 5368709120 bytes)
CACHE_MAX_BYTES=5368709120

# Planned cache retention period in days before eviction of unreferenced files
CACHE_RETENTION_DAYS=7

# Directory paths for raw downloads and processed science arrays
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# ------------------------------------------------------------------------------
# External Archive Client (NASA/IPAC IRSA)
# ------------------------------------------------------------------------------
# Documented IRSA base endpoint (to be verified against official SIAv2 capability)
IRSA_BASE_URL=https://irsa.ipac.caltech.edu
IRSA_REQUEST_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Machine Learning
# ------------------------------------------------------------------------------
MODEL_REGISTRY_DIR=./ml/models
