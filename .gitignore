# ==============================================================================
# SPHEREx TimeLens — Git Ignore Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (Never commit secrets or local overrides)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.token

# ------------------------------------------------------------------------------
# Python & Scientific Computing
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Jupyter & Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# Frontend & Node.js
# ------------------------------------------------------------------------------
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Data, Storage, Databases, and FITS files (Large artifacts excluded)
# ------------------------------------------------------------------------------
# Raw archive data
data/raw/*
!data/raw/README.md

# Processed cutouts, reprojections, difference images
data/processed/*
!data/processed/README.md

# Local cache & SQLite database
data/cache/*
!data/cache/README.md
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# Astronomical FITS and archive archives anywhere in workspace
*.fits
*.fit
*.fits.gz
*.fits.fz
*.h5
*.hdf5
*.asdf
*.tar
*.tar.gz

# ------------------------------------------------------------------------------
# Machine Learning Weights & Checkpoints
# ------------------------------------------------------------------------------
ml/models/*
!ml/models/README.md
*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.bin

# ------------------------------------------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE directories (preserve team configs if explicitly created, exclude user settings)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
